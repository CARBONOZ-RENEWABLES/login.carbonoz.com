DATABASE_URL=
JWT_SECRET=
# Lifetime of legacy login tokens (e.g. 12h). Tokens without an expiry are refused.
JWT_EXPIRES_IN=12h
# Brute-force limit on the password endpoints (login, sign-up, forgot-password,
# verification): attempts per window per client IP and per account (email).
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_WINDOW_S=900
AUTH_RATE_LIMIT_PER_IP=60
AUTH_RATE_LIMIT_PER_ACCOUNT=10
# Behind Cloudflare → Nginx: header with the real client IP, trusted only from
# the local proxy (leave empty without Cloudflare).
CLIENT_IP_HEADER=cf-connecting-ip
# Express "trust proxy" and the proxies allowed to set CLIENT_IP_HEADER: loopback
# (Nginx on this host) plus plain IPs. Backend on 192.168.160.95 behind Nginx on .190:
#   TRUST_PROXY=loopback,192.168.160.190
TRUST_PROXY=loopback
NODE_ENV=development
PORT=
REDEX_API_URL=
REDEX_API_KEY=
REDEX_CLIENT_ID=
REDEX_CLIENT_SECRET=
FRONTED_URL=
ADMIN_EMAIL=admin@carbonoz.com
ADMIN_PASSWORD=change-me-strong-admin-password
# ── Redis (sessions, SolarBMS stream, live snapshot) ─────────────────────
REDIS_URL=redis://localhost:6379

# ── Human sign-in: Keycloak realm "customers" (OIDC, server-side session) ─
# Off unless KEYCLOAK_ENABLED=true and the four values below are set.
KEYCLOAK_ENABLED=false
# Realm for customer logins: confirm with the Keycloak administrator. The realm
# previously written here ("customers") does not exist on auth.carbonoz.com.
KEYCLOAK_ISSUER_URL=https://auth.carbonoz.com/realms/<customer-realm>
KEYCLOAK_CLIENT_ID=carbonoz-login
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=https://login.carbonoz.com/api/v1/auth/oidc/callback
KEYCLOAK_POST_LOGOUT_REDIRECT_URI=https://login.carbonoz.com/
# Link an existing Carbonoz user by Keycloak-verified email on first SSO login.
KEYCLOAK_LINK_BY_EMAIL=true
# ADMIN/SUB_ADMIN accounts are never linked by email unless this is true;
# link them deliberately instead (verified identity mapping).
KEYCLOAK_LINK_PRIVILEGED_BY_EMAIL=false
# Extra origins the login callback may return to (comma separated).
AUTH_RETURN_ORIGINS=https://solar.carbonoz.com

# Session cookie (HttpOnly, SameSite=Lax; Secure unless NODE_ENV=development)
SESSION_COOKIE_NAME=cz_session
# Share the session between login. and solar.carbonoz.com
SESSION_COOKIE_DOMAIN=.carbonoz.com
SESSION_IDLE_TTL_SECONDS=28800
SESSION_ABSOLUTE_TTL_SECONDS=604800

# ── Machine sign-in: SolarBMS devices (never the customer realm) ─────────
# Keycloak client-credentials tokens from a separate realm; leave empty to disable.
# Realm that issues machine tokens: confirm with the Keycloak administrator
# (the Raspberry sender uses "integrations"; "machines" does not exist).
MACHINE_KEYCLOAK_ISSUER_URL=https://auth.carbonoz.com/realms/<machine-realm>
MACHINE_KEYCLOAK_AUDIENCE=carbonoz-ingest
MACHINE_REQUIRED_ROLE=solarbms-ingest
# Per-installation Carbonoz API keys (czk.<id>.<secret>), issued by an admin.
MACHINE_API_KEYS_ENABLED=true

# ── SolarBMS pipeline ─────────────────────────────────────────────────────
# Set false on API nodes if a separate worker process consumes the stream.
SOLAR_WORKER_ENABLED=true
SOLAR_STREAM_KEY=solar:ingest
# Backlog limit: above this many un-trimmed entries, ingest answers 503 (nothing is dropped).
SOLAR_STREAM_MAXLEN=100000
SOLAR_LIVE_TTL_SECONDS=900
# Pending entries idle this long are claimed again; permanently failing
# messages are dead-lettered after SOLAR_MAX_DELIVERIES attempts.
SOLAR_RECLAIM_IDLE_MS=60000
SOLAR_MAX_DELIVERIES=5

# Bridge from the Raspberry ingest pipeline (api.carbonoz.com → ingest API → Redis
# stream `ingest:readings` on the ingest Redis) into this API. Off by default.
# Readings are matched to an installation by `site` = the installation's systemId
# (Admin → Installations; must be unique). Each stream entry is acknowledged only
# after its readings are stored in MongoDB. See docs/platform-architecture.md.
INGEST_BRIDGE_ENABLED=false
# xread: read-only account (XREAD, XRANGE, XLEN, XINFO); position in MongoDB.
# group: consumer group created by the Redis admin; also needs XREADGROUP, XACK, XAUTOCLAIM.
INGEST_BRIDGE_MODE=xread
INGEST_GROUP=carbonoz-bridge
# Stable consumer name per API instance (group mode); empty = carbonoz-<hostname>.
INGEST_CONSUMER=
INGEST_CLAIM_IDLE_MS=60000
# redis://consumer:<password>@<ingest-redis-host>:6379 — from the password manager, never the admin account.
INGEST_REDIS_URL=
INGEST_STREAM_KEY=ingest:readings
# Stream field holding the delivery JSON; empty = detected.
INGEST_PAYLOAD_FIELD=
# First start without a stored position (anything else is refused):
#   0-0 = everything still in the stream; <ms>-<seq> = after that entry;
#   $ = after the newest entry at the first start (resolved once and stored).
INGEST_BRIDGE_START=0-0
INGEST_BRIDGE_BATCH=50
INGEST_BRIDGE_BLOCK_MS=5000

# ── Cut-over ─────────────────────────────────────────────────────────────
# false → password sign-in/sign-up, email-verification/reset links and every legacy
# bearer JWT are rejected; only Keycloak sessions and machine credentials work.
LEGACY_AUTH_ENABLED=true

# ── API documentation ────────────────────────────────────────────────────
# Swagger UI at /swagger. Keep false in production (it publishes every route).
SWAGGER_ENABLED=false
